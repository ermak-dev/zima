<?xml version="1.0"?>
<robot name="roborock_v1">
  <!-- ROS-side description for robot_state_publisher in the playground:
       mirrors models/roborock_v1/model.sdf frames (base_footprint,
       base_link, laser at the live bridge mounting x=-0.100 m). -->
  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="3.5"/>
      <inertia ixx="0.0175" ixy="0" ixz="0" iyy="0.0175" iyz="0" izz="0.0300"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.048" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1725" length="0.096"/>
      </geometry>
      <material name="dark">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.048" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1725" length="0.096"/>
      </geometry>
    </collision>
  </link>

  <link name="laser">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.012" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.024"/>
      </geometry>
      <material name="black">
        <color rgba="0.03 0.03 0.03 1"/>
      </material>
    </visual>
  </link>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.02"/>
      </geometry>
      <material name="tire">
        <color rgba="0.01 0.01 0.01 1"/>
      </material>
    </visual>
  </link>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.02"/>
      </geometry>
      <material name="tire"/>
    </visual>
  </link>

  <link name="caster_front_link">
    <visual>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="-0.100 0 0.096" rpy="0 0 0"/>
  </joint>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="-0.05 0.1225 0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="-0.05 -0.1225 0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front_link"/>
    <origin xyz="0.120 0 0.012" rpy="0 0 0"/>
  </joint>
</robot>
