<?xml version="1.0"?>
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <model name="roborock_v1">
    <pose>0 0 0 0 0 0</pose>

    <!-- Frame contract of the live bridge: base_link is the body frame the
         odom->base_link TF uses; the lidar sits at x=-0.100 (vendor config)
         and publishes as frame "laser". -->
    <link name="base_footprint"/>

    <link name="base_link">
      <inertial>
        <pose>0 0 0.03 0 0 0</pose>
        <inertia>
          <ixx>0.0175</ixx>
          <ixy>0.000</ixy>
          <ixz>0.000</ixz>
          <iyy>0.0175</iyy>
          <iyz>0.000</iyz>
          <izz>0.0300</izz>
        </inertia>
        <mass>3.5</mass>
      </inertial>

      <collision name="base_collision">
        <pose>0 0 0.048 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.1725</radius>
            <length>0.096</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
          </friction>
        </surface>
      </collision>

      <visual name="base_visual">
        <pose>0 0 0.048 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.1725</radius>
            <length>0.096</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.13 0.13 0.13 1</ambient>
          <diffuse>0.20 0.20 0.20 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>

      <!-- Front bumper bar (visual only). -->
      <visual name="bumper_visual">
        <pose>0.155 0 0.030 0 0 0</pose>
        <geometry>
          <box><size>0.02 0.24 0.05</size></box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- LDS tower: 360-beam planar lidar, 5 Hz like the live vacuum,
         mounted at x=-0.100 per the vendor config the bridge uses. -->
    <link name="laser">
      <!-- SDF places a link by its own pose (a joint pose would only move
           the joint frame): same mount as the URDF laser_joint origin. -->
      <pose>-0.100 0 0.096 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz>
        </inertia>
      </inertial>
      <collision name="lds_collision">
        <pose>0 0 0.012 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.036</radius><length>0.024</length></cylinder>
        </geometry>
      </collision>
      <visual name="lds_visual">
        <pose>0 0 0.012 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.036</radius><length>0.024</length></cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>
      <sensor name="lds_lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <topic>scan</topic>
        <gz_frame_id>laser</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <!-- Drive wheels: Xiaomi V1 track ~ 0.245 m center-to-center, wheel
         radius 0.035 m. -->
    <link name="wheel_left_link">
      <pose>-0.05 0.1225 0.035 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz>
        </inertia>
      </inertial>
      <collision name="wheel_left_collision">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.02</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.3</mu><mu2>1.3</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="wheel_left_visual">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>0.01 0.01 0.01 1</ambient>
          <diffuse>0.01 0.01 0.01 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="wheel_right_link">
      <pose>-0.05 -0.1225 0.035 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz>
        </inertia>
      </inertial>
      <collision name="wheel_right_collision">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.02</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.3</mu><mu2>1.3</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="wheel_right_visual">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>0.01 0.01 0.01 1</ambient>
          <diffuse>0.01 0.01 0.01 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Front caster ball. -->
    <link name="caster_front_link">
      <pose>0.120 0 0.012 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000005</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000005</iyy><iyz>0</iyz><izz>0.000005</izz>
        </inertia>
      </inertial>
      <collision name="caster_collision">
        <geometry>
          <sphere><radius>0.012</radius></sphere>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="caster_visual">
        <geometry>
          <sphere><radius>0.012</radius></sphere>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="base_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>base_link</child>
    </joint>

    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_left_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_right_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="caster_front_joint" type="ball">
      <parent>base_link</parent>
      <child>caster_front_link</child>
    </joint>

    <joint name="laser_joint" type="fixed">
      <parent>base_link</parent>
      <child>laser</child>
    </joint>

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.245</wheel_separation>
      <wheel_radius>0.035</wheel_radius>
      <!-- Vacuum-safe limits from the project rules (0.1 m/s, 0.4 rad/s),
           enforced here at the physics level too. -->
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <min_linear_acceleration>-0.5</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_linear_velocity>0.1</max_linear_velocity>
      <min_linear_velocity>-0.1</min_linear_velocity>
      <max_angular_velocity>0.4</max_angular_velocity>
      <min_angular_velocity>-0.4</min_angular_velocity>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
