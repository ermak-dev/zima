<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>player_to_ros2</name>
  <version>0.1.0</version>
  <description>Bridge the vacuum's Player server (laser:0, position2d:0) into ROS 2.</description>
  <maintainer email="ermak@example.invalid">ermak</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cargo</buildtool_depend>

  <depend>rclrs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
