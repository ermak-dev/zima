#!/usr/bin/env bash
# Control the rooted vacuum through Player without starting cleaning.
# Usage: robot [--config FILE] <command>  # private mode-0600 TOML; paths relative to FILE
#        robot serve [--config FILE] [--port N] [--listen HOST]  # host HTTP/audio, no controller handoff
#        robot daemon start [--config FILE]  # explicitly deploy/start persistent supervisor
# Usage: robot enable|disable|status        # stock controller handoff
#        robot position|fan|battery|stop   # battery: read-only power:0 JSON
#        robot snapshot [output.jpg]
#        robot diagnose lidar OUTPUT_DIR  # read-only vendor files for offline timing audit
#        robot record <output.wav> [--seconds N] [--gain 0..90]  # test WAV, no ROS
#        robot say "text" [--volume V]  # shared web TTS API; settings from TOML
#        robot audio <command>   # capture, playback, speech (see audio --help)
#        robot move [--with-controller] forward|backward|left|right <seconds (0, 2]>
#        robot mask hold [--mask HEX] [--timeout SECS]   # requires controller stopped
#        robot mask restore
#        robot run [--port N] [--listen HOST] [--no-slam] [--no-yolo]  # MRPT + YOLO by default
#                  [--slam-adapter EXE] [--yolo-adapter EXE] [--supervisor HOST:PORT]
#        robot panel [--port N] [--listen HOST]  # alias for run (hands over controller)
#        robot bridge [--port N] [--listen HOST] # alias for run
#        robot bug <list|show|labels|new|comment|edit|close|reopen|relabel|start|mr|project> ...
set -euo pipefail

# Config values cross this boundary only as environment data, never shell code.
if [[ ${_ROBOT_CONFIG_LOADED:-} != 1 && ${1:-} != --help && ${1:-} != -h && ${1:-} != help && ${1:-} != bug ]]; then
    exec python3 "$(dirname "$(realpath "$0")")/config.py" "$@"
fi
unset _ROBOT_CONFIG_LOADED
ssh_cmd=${ROBOT_SSH:-ssh}
ssh_host=${ROBOT_SSH_HOST:-robot}

# Wrap ssh with hard limits: a dead robot (or flaky Wi-Fi) must fail fast
# instead of hanging a session (or its teardown) forever. Disable/enable
# legitimately take ~10 s (watchdog restart), uploads on slow Wi-Fi need
# more; -G is instant.
ssh_wrap() {
    local timeout_s=${ROBOT_SSH_TIMEOUT_S:-60}
    case $1 in
        -G) timeout 10 "$ssh_cmd" "$@" ;;
        *)  timeout "$timeout_s" "$ssh_cmd" "$@" ;;
    esac
}

usage() { sed -n '2,/^set /{ /^# /s/^# //p; }' "$0"; }
fail() { echo "robot: $*" >&2; exit 2; }
repo_root() { cd "$(dirname "$(realpath "$0")")/.." && pwd; }

# Upload a file to the robot only when it differs (sha256 compare), via a
# tmp+mv so a partial transfer never replaces the live remote file.
# <local_path> <remote_path>
deploy_file() {
    local local_path=$1 remote_path=$2 remote_sha local_sha
    ssh_wrap "$ssh_host" mkdir -p -- "$(dirname "$remote_path")" >&2
    remote_sha=$(ssh_wrap "$ssh_host" "sha256sum $remote_path 2>/dev/null | cut -d' ' -f1") || true
    local_sha=$(sha256sum "$local_path" | cut -d' ' -f1)
    if [[ $remote_sha != "$local_sha" ]]; then
        ssh_wrap "$ssh_host" "for executable in /proc/[0-9]*/exe; do
            if test \"\$executable\" -ef $remote_path; then
                printf '%s\\n' 'robot: executable is in use; refusing to replace it' >&2
                exit 1
            fi
        done
        cat > $remote_path.tmp && chmod 700 $remote_path.tmp && mv $remote_path.tmp $remote_path" <"$local_path" >&2 \
            || fail "could not upload $(basename "$remote_path")"
    fi
}

controller_status() {
    ssh_wrap "$ssh_host" bash -s <<'REMOTE'
set -e
# ROBOT_STATUS_COMMANDS
list=/opt/rockrobo/watchdog/ProcessList.conf
if grep -Fqx 'RoboController,setsid RoboController&,1,3,0' "$list" && pgrep -x RoboController >/dev/null && pgrep -x WatchDoge >/dev/null; then
    echo enabled
elif grep -Fqx '# ROBOT_DISABLED: RoboController,setsid RoboController&,1,3,0' "$list" && ! pgrep -x RoboController >/dev/null && pgrep -x WatchDoge >/dev/null; then
    echo disabled
else
    echo 'inconsistent controller/watchdog state' >&2
    exit 1
fi
REMOTE
}

controller_disable() {
    ssh_wrap "$ssh_host" bash -s <<'REMOTE'
set -euo pipefail
# ROBOT_DISABLE_CONTROLLER
list=${ROBOT_PROCESS_LIST:-/opt/rockrobo/watchdog/ProcessList.conf}
backup=${ROBOT_BACKUP:-/mnt/data/rockrobo/ProcessList.conf.robot-backup}
entry='RoboController,setsid RoboController&,1,3,0'
marker="# ROBOT_DISABLED: $entry"
tmp=
changed=0
rollback() {
    if (( changed )) && [[ -f $backup ]]; then
        cp -p "$backup" "$list"
        if initctl restart rrwatchdoge >&2; then
            rm -f "$backup"
        else
            echo 'robot: watchdog restart failed during rollback; recovery copy preserved' >&2
        fi
    fi
}
cleanup() {
    local status=$?
    [[ -z $tmp ]] || rm -f "$tmp"
    if (( status )); then rollback; fi
}
trap cleanup EXIT

if ! grep -Fqx "$marker" "$list"; then
    # The entry is enabled. A lingering recovery copy is stale (a previous
    # session's rollback already restored the entry): drop it when it
    # matches the live config, refuse when it does not — that would be
    # someone else's state to inspect.
    if [[ -e $backup ]] && { ! grep -Fqx "$entry" "$list" || ! cmp -s "$backup" "$list"; }; then
        echo 'robot: existing controller recovery copy; inspect before proceeding' >&2
        exit 1
    fi
    rm -f "$backup"
    [[ $(grep -Fxc "$entry" "$list") == 1 ]] || { echo 'robot: unexpected RoboController entry' >&2; exit 1; }
    cp -p "$list" "$backup"
    changed=1
    tmp=$(mktemp "${list}.robot.XXXXXX")
    cp -p "$list" "$tmp"
    awk -v entry="$entry" -v marker="$marker" '{ if ($0 == entry) print marker; else print }' "$list" > "$tmp"
    mv -f "$tmp" "$list"
    tmp=
elif [[ ! -f $backup ]]; then
    echo 'robot: disabled entry has no recovery copy' >&2
    exit 1
fi

initctl restart rrwatchdoge
# The old WatchDoge may take seconds to die after the restart; retry the
# readiness check instead of failing (and rolling back) mid-respawn.
for i in $(seq 1 30); do
    pgrep -x WatchDoge >/dev/null && break
    sleep 1
done
pgrep -x WatchDoge >/dev/null || { echo 'robot: watchdog failed to start' >&2; exit 1; }
if pgrep -x RoboController >/dev/null; then
    pkill -TERM -x RoboController
    for i in $(seq 1 30); do
        if ! pgrep -x RoboController >/dev/null; then break; fi
        sleep 1
    done
fi
! pgrep -x RoboController >/dev/null || { echo 'robot: controller remained running' >&2; exit 1; }
echo 'controller disabled; watchdog and Player remain running'
REMOTE
}

controller_enable() {
    # The enable logic lives in ONE place: controller-restore.sh (also
    # deployed to the robot for the supervisor's rollback). Running it over
    # ssh keeps `robot enable` and the supervisor's restore byte-identical;
    # the script is idempotent and validates its own preconditions.
    # deploy_file's sha compare makes the common path one cheap ssh call.
    deploy_file "$(repo_root)/crates/mask-owner/controller-restore.sh" /tmp/mask-owner/controller-restore.sh
    ssh_wrap "$ssh_host" bash -s <<'REMOTE'
set -euo pipefail
# ROBOT_ENABLE_CONTROLLER
exec /tmp/mask-owner/controller-restore.sh
REMOTE
}

robot_host() {
    local out
    if ! out=$(ssh_wrap -G "$ssh_host" 2>/dev/null | awk '$1 == "hostname" { print $2 }'); then
        fail 'cannot resolve SSH host robot (ssh -G failed)'
    fi
    [[ -n $out ]] || fail 'cannot resolve SSH host robot'
    printf '%s\n' "$out"
}

# Run the Rust robotctl client (position/fan/move/stop) against the robot.
robotctl() {
    local binary=${ROBOT_ROBOTCTL_BIN:-} repo
    if [[ -z $binary ]]; then
        repo=$(repo_root)
        binary=$repo/crates/target/release/robotctl
        [[ -x $binary ]] || binary=$repo/crates/target/debug/robotctl
        [[ -x $binary ]] || fail 'robotctl binary is missing; build: (cd crates && cargo build --release)'
    fi
    local host=${ROBOT_PLAYER_HOST:-}
    [[ -n $host ]] || host=$(robot_host)
    [[ -n $host ]] || fail 'cannot resolve SSH host robot'
    export ROBOTCTL_PORT=${ROBOTCTL_PORT:-${ROBOT_PLAYER_PORT:-6665}}
    if [[ ${1:-} == move ]]; then
        local guard
        guard=$(ssh_wrap "$ssh_host" bash -s <<'REMOTE'
set -e
marker=$(mktemp /tmp/robot-drive-guard.XXXXXX)
nohup sh -c 'sleep 10; if test -f "$1"; then pkill -TERM -x player; rm -f "$1"; fi' robot-guard "$marker" </dev/null >/dev/null 2>&1 &
echo "$marker"
REMOTE
)
        [[ $guard == /tmp/robot-drive-guard.* && $guard != *[!a-zA-Z0-9_./-]* ]] || fail 'could not arm on-robot stop guard'
        if "$binary" "$host" "$@"; then
            ssh_wrap "$ssh_host" rm -f -- "$guard"
        else
            echo 'robot: movement failed; on-robot guard will restart Player after 10 seconds' >&2
            return 1
        fi
    else
        "$binary" "$host" "$@"
    fi
}

# Deploy the ARM mask-owner binary if needed and print its remote path.
# Only the path goes to stdout: ssh replies are consumed or sent to stderr,
# so the caller's command substitution stays clean.
mask_owner_remote() {
    local binary=${ROBOT_MASK_OWNER_BIN:-} remote=/tmp/mask-owner/mask-owner
    if [[ -z $binary ]]; then
        binary=$(repo_root)/crates/target/armv7-unknown-linux-musleabihf/release/mask-owner
        [[ -x $binary ]] || fail 'mask-owner binary is missing; build: (cd crates && cargo build -p mask-owner --release --target armv7-unknown-linux-musleabihf)'
    fi
    deploy_file "$binary" "$remote"
    printf '%s\n' "$remote"
}

supervisor_request() {
    local port=$1 timeout_ms=$2 mode=$3 expected_sha=$4
    # Credentials travel only over SSH stdin, never argv or logs.
    {
        printf 'port=%q\ntimeout_ms=%q\nmode=%q\nlisten=%q\nexpected_sha=%q\n' "$port" "$timeout_ms" "$mode" "${ROBOT_SUPERVISOR_LISTEN:-0.0.0.0}" "$expected_sha"
        printf 'export ROBOT_SUPERVISOR_TOKEN=%q\n' "${ROBOT_SUPERVISOR_TOKEN:-}"
        cat <<'REMOTE'
set -euo pipefail
# ROBOT_SUPERVISOR_START
remote=/tmp/mask-owner/robot-supervisor
[[ $expected_sha =~ ^[0-9a-f]{64}$ ]] || exit 4
request() {
    (
        exec 3<>"/dev/tcp/127.0.0.1/$port" || exit 3
        printf 'AUTH %s\n' "$ROBOT_SUPERVISOR_TOKEN" >&3 || exit 4
        IFS= read -r -t 3 reply <&3 || exit 4
        [[ $reply == AUTHENTICATED ]] || exit 4
        printf '%s\n' "$1" >&3 || exit 4
        IFS= read -r -t 3 reply <&3 || exit 4
        printf '%s\n' "$reply"
    ) 2>/dev/null
}
listener_pid() {
    local hex inodes executable target candidate='' pid descriptor socket inode
    local tables=(/proc/net/tcp)
    [[ ! -r /proc/net/tcp6 ]] || tables+=(/proc/net/tcp6)
    hex=$(printf '%04X' "$port")
    inodes=$(awk -v p="$hex" '$4=="0A" && ($2=="0100007F:"p || $2=="00000000:"p || $2=="00000000000000000000000000000000:"p) {print $10}' "${tables[@]}") || return 4
    [[ -n $inodes ]] || return 4
    for executable in /proc/[0-9]*/exe; do
        target=$(readlink "$executable" 2>/dev/null) || continue
        [[ $target == "$remote" || $target == "$remote (deleted)" ]] || continue
        pid=${executable%/exe}; pid=${pid##*/}
        for descriptor in /proc/"$pid"/fd/*; do
            socket=$(readlink "$descriptor" 2>/dev/null) || continue
            for inode in $inodes; do
                if [[ $socket == "socket:[$inode]" ]]; then
                    [[ -z $candidate || $candidate == "$pid" ]] || return 4
                    candidate=$pid
                fi
            done
        done
    done
    [[ -n $candidate ]] || return 4
    printf '%s\n' "$candidate"
}
probe() {
    local reply
    reply=$(request PING) || return "$?"
    case $reply in
        'PONG ACTIVE') return 2 ;;
        'PONG IDLE') ;;
        *) return 4 ;;
    esac
    daemon_pid=$(listener_pid) || return 4
    daemon_sha=$(sha256sum "/proc/$daemon_pid/exe" | cut -d' ' -f1) || return 4
    [[ $daemon_sha != "$expected_sha" ]] || return 0
    return 5
}
legacy_shutdown() {
    local fd extra reply status started=$SECONDS previous='' arg activate_ms=10000
    local held=()
    while IFS= read -r -d '' arg; do
        if [[ $previous == --activate-timeout-ms ]]; then activate_ms=$arg; fi
        previous=$arg
    done < "/proc/$daemon_pid/cmdline"
    [[ $activate_ms =~ ^[0-9]+$ && ${#activate_ms} -le 9 ]] || return 4
    (( 10#$activate_ms >= 10000 )) || return 4
    # Legacy listeners have 32 lifetime client slots. Holding all of them after
    # AUTH proves there is no owner, rollback or audio handler, and prevents a
    # new ACTIVATE racing the stop. Never rely on a previous PONG IDLE alone.
    for _ in {1..32}; do
        (( SECONDS - started < 3 )) || return 2
        exec {fd}<>"/dev/tcp/127.0.0.1/$port" || return 2
        held+=("$fd")
        printf 'AUTH %s\n' "$ROBOT_SUPERVISOR_TOKEN" >&"$fd" || return 2
        IFS= read -r -t 1 reply <&"$fd" || return 2
        [[ $reply == AUTHENTICATED ]] || return 4
    done
    # Refuse unknown generations with more slots instead of assuming the gate
    # is closed. Capacity rejection must be EOF, not a silent accepted socket.
    exec {extra}<>"/dev/tcp/127.0.0.1/$port" || return 4
    if IFS= read -r -n 1 -t 1 reply <&"$extra"; then return 4; else status=$?; fi
    exec {extra}<&-
    [[ $status == 1 ]] || return 4
    (( SECONDS - started < 3 )) || return 2
    [[ $(listener_pid) == "$daemon_pid" ]] || return 4
    [[ $(sha256sum "/proc/$daemon_pid/exe" | cut -d' ' -f1) == "$daemon_sha" ]] || return 4
    (( SECONDS - started < 3 )) || return 2
    kill -TERM "$daemon_pid"
}
if [[ $mode == update ]]; then
    lock=/tmp/mask-owner/update.lock
    mkdir "$lock" 2>/dev/null || { echo 'robot: supervisor update already locked' >&2; exit 2; }
    trap 'rmdir "$lock" 2>/dev/null || true' EXIT
    if probe; then exit 0; else status=$?; fi
    [[ $status == 5 ]] || exit "$status"
    stage="$remote.$expected_sha.next"
    [[ -f $stage && ! -L $stage && -x $stage ]] || exit 4
    [[ $(sha256sum "$stage" | cut -d' ' -f1) == "$expected_sha" ]] || exit 4
    reply=$(request SHUTDOWN) || exit "$?"
    case $reply in
        STOPPING) ;;
        BUSY) echo 'robot: supervisor is busy; update refused' >&2; exit 2 ;;
        REFUSED) legacy_shutdown || exit "$?" ;;
        *) exit 4 ;;
    esac
    for _ in {1..30}; do
        [[ -e /proc/$daemon_pid/exe ]] || break
        sleep 0.1
    done
    [[ ! -e /proc/$daemon_pid/exe ]] || { echo 'robot: supervisor did not stop; update aborted' >&2; exit 2; }
    for executable in /proc/[0-9]*/exe; do
        if test "$executable" -ef "$remote"; then
            echo 'robot: supervisor executable is still in use; update aborted' >&2
            exit 2
        fi
    done
    [[ $(sha256sum "$stage" | cut -d' ' -f1) == "$expected_sha" ]] || exit 4
    mv -f -- "$stage" "$remote"
    exit 0
fi
if probe; then
    exit 0
else
    status=$?
    [[ $mode == check ]] && exit "$status"
    if [[ $status == 2 ]]; then
        [[ $mode == start ]] && exit 0
        echo 'robot: supervisor has an active session; refusing to disturb it' >&2
        exit 2
    fi
    [[ $status == 3 ]] || exit "$status"
fi
nohup /tmp/mask-owner/robot-supervisor listen --listen "$listen" --heartbeat-port "$port" --timeout-ms "$timeout_ms" >> /tmp/robot-supervisor.log 2>&1 < /dev/null &
pid=$!
for _ in {1..30}; do
    kill -0 "$pid" 2>/dev/null || { echo 'robot: supervisor failed to start' >&2; exit 1; }
    if probe; then
        exit 0
    else
        status=$?
        if [[ $status == 2 ]]; then
            [[ $mode == start ]] && exit 0
            exit 2
        fi
    fi
    sleep 0.1
done
echo 'robot: supervisor did not become ready' >&2
exit 1
REMOTE
    } | ssh_wrap "$ssh_host" bash -s >&2
}

supervisor_start() {
    local port=${1:-7665} timeout_ms=${2:-5000} mode=${3:-auto} status
    local repo binary=${ROBOT_SUPERVISOR_BIN:-} sha
    repo=$(repo_root)
    [[ -f $binary && -x $binary ]] || fail 'robot-supervisor binary is missing; build: tools/build-supervisor.sh'
    sha=$(sha256sum "$binary" | cut -d' ' -f1)
    if supervisor_request "$port" "$timeout_ms" check "$sha"; then
        return
    else
        status=$?
    fi
    if [[ $status == 2 ]]; then
        [[ $mode == start ]] && return
        fail 'supervisor has an active session; controller was not changed'
    fi
    case $status in
        3)
            deploy_file "$binary" /tmp/mask-owner/robot-supervisor
            deploy_file "$repo/crates/mask-owner/controller-restore.sh" /tmp/mask-owner/controller-restore.sh ;;
        5)
            printf '%s\n' 'robot: updating idle supervisor' >&2
            deploy_file "$binary" "/tmp/mask-owner/robot-supervisor.$sha.next"
            supervisor_request "$port" "$timeout_ms" update "$sha" \
                || fail 'cannot update idle supervisor; controller was not changed' ;;
        *) fail 'cannot authenticate or identify supervisor; controller was not changed' ;;
    esac
    supervisor_request "$port" "$timeout_ms" "$mode" "$sha" \
        || fail 'cannot start authenticated supervisor; controller was not changed'
}

server_cleanup() {
    local rc=$? current
    trap - EXIT INT TERM
    if [[ -n $server_pid ]] && kill -0 "$server_pid" 2>/dev/null; then
        kill -TERM "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
    if (( handoff )); then
        current=$(controller_status) || current=unknown
        if [[ $current != enabled ]]; then
            controller_enable >&2 || { echo 'robot: controller recovery failed' >&2; rc=1; }
        fi
    fi
    exit "$rc"
}

cmd=${1:---help}
(( $# == 0 )) || shift
case $cmd in
    --help|-h|help) usage ;;
    enable|disable)
        (( $# == 0 )) || fail "usage: robot $cmd"
        case $cmd in
            enable) controller_enable ;;
            disable) controller_disable ;;
        esac ;;
    status)
        (( $# == 0 )) || fail 'usage: robot status'
        controller_status ;;
    position|fan|battery)
        (( $# == 0 )) || fail "$cmd takes no arguments"
        robotctl "$cmd" ;;
    snapshot)
        exec "${ROBOT_CAMERA_BIN:-$(dirname "$(realpath "$0")")/camera/snapshot}" "$@" ;;
    diagnose)
        exec python3 -I "$(repo_root)/bin/diagnostics/lidar.py" "$@" ;;
    record)
        # Standalone test capture: no ROS, no controller, no robot modes. Use
        # `robot audio record` instead while an audio service owns the stream.
        if [[ -n ${ROBOT_AUDIO_BIN:-} ]]; then exec "$ROBOT_AUDIO_BIN" capture "$@"; fi
        exec python3 "$(repo_root)/bin/audio/cli.py" capture "$@" ;;
    audio)
        if [[ -n ${ROBOT_AUDIO_BIN:-} ]]; then exec "$ROBOT_AUDIO_BIN" "$@"; fi
        exec python3 "$(repo_root)/bin/audio/cli.py" "$@" ;;
    say)
        exec python3 "$(repo_root)/bin/audio/say.py" "$@" ;;
    bug)
        exec "${ROBOT_BUG_BIN:-$(dirname "$(realpath "$0")")/bug}" "$@" ;;
    move)
        with_controller=0
        if [[ ${1:-} == --with-controller ]]; then with_controller=1; shift; fi
        (( $# == 2 )) || fail 'usage: robot move [--with-controller] forward|backward|left|right <seconds>'
        case $1 in forward|backward|left|right) ;; *) fail 'unknown direction' ;; esac
        [[ $2 =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]] || fail 'duration must be a finite positive number'
        awk -v n="$2" 'BEGIN {exit !(n > 0 && n <= 2)}' || fail 'duration must be between 0 and 2 seconds'
        state=$(controller_status)
        if (( with_controller )); then
            [[ $state == enabled ]] || fail '--with-controller requires the stock controller to be running'
        else
            [[ $state == disabled ]] || fail 'stop the stock controller first (robot disable), or use --with-controller for a supervised test'
        fi
        robotctl move "$1" "$2" ;;
    mask)
        remote='' timeout=5 mask=10f8ff
        case ${1:-} in
            hold)
                shift
                while [[ $# -gt 0 ]]; do
                    case $1 in
                        --mask)
                            [[ $2 =~ ^[0-9a-fA-F]{6}$ ]] || fail 'mask must be exactly 6 hex digits (e.g. 10f8ff)'
                            mask=${2,,}; shift 2 ;;
                        --timeout)
                            [[ $2 =~ ^[1-9][0-9]*$ ]] || fail 'timeout must be positive seconds'
                            timeout=$2; shift 2 ;;
                        *) fail "unknown mask hold option: $1" ;;
                    esac
                done
                [[ $(( 0x$mask )) -ne 0 ]] || fail 'mask must not be zero'
                state=$(controller_status)
                [[ $state == disabled ]] || fail 'stop the stock controller first: the mask owner must be the sole IPC party'
                remote=$(mask_owner_remote)
                ssh_wrap "$ssh_host" "$remote" hold --mask "$mask" --timeout "$timeout" ;;
            restore)
                shift
                (( $# == 0 )) || fail 'usage: robot mask restore'
                remote=$(mask_owner_remote)
                ssh_wrap "$ssh_host" "$remote" restore ;;
            *) fail 'usage: robot mask hold [--mask HEX] [--timeout SECS] | restore' ;;
        esac ;;
    daemon)
        [[ $# == 1 && $1 == start ]] || fail 'usage: robot daemon start [--config FILE]'
        supervisor_start "${ROBOT_SUPERVISOR_PORT:-7665}" "${ROBOT_SUPERVISOR_TIMEOUT_MS:-5000}" start ;;
    run|panel|bridge|serve)
        port=${ROBOT_SERVER_PORT:-8085} listen=${ROBOT_SERVER_LISTEN:-127.0.0.1}
        heartbeat_port=${ROBOT_SUPERVISOR_PORT:-7665} timeout_ms=${ROBOT_SUPERVISOR_TIMEOUT_MS:-5000}
        supervisor_host=${ROBOT_SUPERVISOR_HOST:-}
        slam_adapter=${ROBOT_SLAM_ADAPTER-$(repo_root)/tools/mrpt-adapter/adapter}
        yolo_adapter=${ROBOT_YOLO_ADAPTER-$(repo_root)/tools/yolo/adapter}
        if [[ $cmd == serve ]]; then slam_adapter=; yolo_adapter=; fi
        while (( $# )); do
            case $1 in
                --port|--listen|--heartbeat-port|--timeout-ms|--slam-adapter|--yolo-adapter|--supervisor)
                    (( $# >= 2 )) || fail "missing value for $1"
                    case $1 in
                        --port) port=$2 ;;
                        --listen) listen=$2 ;;
                        --heartbeat-port) heartbeat_port=$2 ;;
                        --supervisor)
                            [[ $2 =~ ^([a-zA-Z0-9_.-]+|\[[a-fA-F0-9:]+\]):[0-9]+$ ]] || fail 'invalid supervisor address; expected HOST:PORT'
                            supervisor_host=${2%:*}
                            heartbeat_port=${2##*:} ;;
                        --timeout-ms) timeout_ms=$2 ;;
                        --yolo-adapter)
                            [[ -f $2 && -x $2 ]] || fail "YOLO adapter is missing or not executable: $2"
                            yolo_adapter=$2 ;;
                        --slam-adapter)
                            [[ -f $2 ]] || fail "--slam-adapter: $2 is not a file"
                            slam_adapter=$2 ;;
                    esac
                    shift 2 ;;
                --no-slam) slam_adapter=; shift ;;
                --no-yolo) yolo_adapter=; shift ;;
                *) fail 'usage: robot run [--port N] [--listen HOST] [--heartbeat-port N] [--timeout-ms M] [--slam-adapter EXE|--no-slam] [--yolo-adapter EXE|--no-yolo]' ;;
            esac
        done
        for number in "$port" "$heartbeat_port"; do
            if [[ ! $number =~ ^[0-9]{1,5}$ ]] || (( 10#$number < 1 || 10#$number > 65535 )); then
                fail 'port must be an integer in 1..65535'
            fi
        done
        if [[ ! $timeout_ms =~ ^[0-9]{1,6}$ ]] || (( 10#$timeout_ms < 100 || 10#$timeout_ms > 300000 )); then
            fail 'timeout must be an integer in 100..300000 milliseconds'
        fi
        [[ $listen =~ ^[a-zA-Z0-9_.:-]+$ ]] || fail 'invalid listen address'
        repo=$(repo_root)
        binary=${ROBOT_SERVER_BIN:-$repo/crates/target/release/robot-server}
        if [[ -z ${ROBOT_SERVER_BIN:-} && ! -x $binary ]]; then
            binary=$repo/crates/target/debug/robot-server
        fi
        [[ -x $binary ]] || fail 'robot-server binary is missing; build: cargo build --manifest-path crates/Cargo.toml --release'
        if [[ -n $slam_adapter && ! -x $slam_adapter ]]; then
            fail "SLAM adapter is missing or not executable: $slam_adapter; see tools/mrpt-adapter/README.md or use --no-slam"
        fi
        if [[ -n $yolo_adapter && ( ! -f $yolo_adapter || ! -x $yolo_adapter ) ]]; then
            fail "YOLO adapter is missing or not executable: $yolo_adapter; see tools/yolo/README.md or use --no-yolo"
        fi
        if [[ $cmd == serve ]]; then
            host=${supervisor_host:-${ROBOT_PLAYER_HOST:-}}
            [[ -n $host ]] || host=$(robot_host)
            export ROBOT_SUPERVISOR_ADDR="$host:$heartbeat_port"
            exec "$binary" --audio-only --listen "$listen" --port "$port"
        fi
        lock=${ROBOT_SESSION_LOCK:-${XDG_RUNTIME_DIR:-/tmp}/robot-server-$UID.lock}
        exec 9>"$lock"
        flock -n 9 || fail 'a robot server session is already running on this host'
        host=$(robot_host)
        server_pid='' handoff=0
        trap server_cleanup EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        supervisor_start "$heartbeat_port" "$timeout_ms"
        [[ $(controller_status) == enabled ]] || fail 'controller already handed off; refusing to disturb another session'
        handoff=1
        controller_disable >&2
        server_args=(--player-host "${ROBOT_PLAYER_HOST:-$host}" --player-port "${ROBOT_PLAYER_PORT:-6665}" --listen "$listen" --port "$port")
        [[ -n $slam_adapter ]] && server_args+=(--slam-adapter "$slam_adapter")
        [[ -n $yolo_adapter ]] && server_args+=(--yolo-adapter "$yolo_adapter")
        export ROBOT_SUPERVISOR_ADDR="${supervisor_host:-$host}:$heartbeat_port"
        ROBOT_SERVER_HEARTBEAT="$ROBOT_SUPERVISOR_ADDR" \
            "$binary" "${server_args[@]}" &
        server_pid=$!
        status=0
        wait "$server_pid" || status=$?
        server_pid=
        exit "$status" ;;
    stop)
        (( $# == 0 )) || fail 'stop takes no arguments'
        robotctl stop ;;
    *) fail "unknown command: $cmd" ;;
esac
