#!/usr/bin/env bash
# Control the rooted vacuum through Player without starting cleaning.
# Usage: robot enable|disable|status        # stock controller handoff
#        robot position|fan|stop
#        robot snapshot [output.jpg]
#        robot move [--with-controller] forward|backward|left|right <seconds (0, 2]>
#        robot mask hold [--mask HEX] [--timeout SECS]   # requires controller stopped
#        robot mask restore
#        robot bug <list|show|labels|new|comment|edit|close|reopen|relabel|start|mr|project> ...
set -euo pipefail

ssh_cmd=${ROBOT_SSH:-ssh}

usage() { sed -n '2,9s/^# //p' "$0"; }
fail() { echo "robot: $*" >&2; exit 2; }

controller_status() {
    "$ssh_cmd" robot bash -s <<'REMOTE'
set -e
# ROBOT_STATUS_COMMANDS
list=/opt/rockrobo/watchdog/ProcessList.conf
if grep -Fqx 'RoboController,setsid RoboController&,1,3,0' "$list" && pgrep -x RoboController >/dev/null && pgrep -x WatchDoge >/dev/null; then
    echo enabled
elif grep -Fqx '# ROBOT_DISABLED: RoboController,setsid RoboController&,1,3,0' "$list" && ! pgrep -x RoboController >/dev/null && pgrep -x WatchDoge >/dev/null; then
    echo disabled
else
    echo 'inconsistent controller/watchdog state' >&2
    exit 1
fi
REMOTE
}

controller_disable() {
    "$ssh_cmd" robot bash -s <<'REMOTE'
set -euo pipefail
# ROBOT_DISABLE_CONTROLLER
list=${ROBOT_PROCESS_LIST:-/opt/rockrobo/watchdog/ProcessList.conf}
backup=${ROBOT_BACKUP:-/mnt/data/rockrobo/ProcessList.conf.robot-backup}
entry='RoboController,setsid RoboController&,1,3,0'
marker="# ROBOT_DISABLED: $entry"
tmp=
changed=0
rollback() {
    if (( changed )) && [[ -f $backup ]]; then
        cp -p "$backup" "$list"
        if initctl restart rrwatchdoge >&2; then
            rm -f "$backup"
        else
            echo 'robot: watchdog restart failed during rollback; recovery copy preserved' >&2
        fi
    fi
}
cleanup() {
    local status=$?
    [[ -z $tmp ]] || rm -f "$tmp"
    if (( status )); then rollback; fi
}
trap cleanup EXIT

if grep -Fqx "$marker" "$list"; then
    [[ -f $backup ]] || { echo 'robot: disabled entry has no recovery copy' >&2; exit 1; }
else
    [[ ! -e $backup ]] || { echo 'robot: existing controller recovery copy; inspect before proceeding' >&2; exit 1; }
    [[ $(grep -Fxc "$entry" "$list") == 1 ]] || { echo 'robot: unexpected RoboController entry' >&2; exit 1; }
    cp -p "$list" "$backup"
    changed=1
    tmp=$(mktemp "${list}.robot.XXXXXX")
    cp -p "$list" "$tmp"
    awk -v entry="$entry" -v marker="$marker" '{ if ($0 == entry) print marker; else print }' "$list" > "$tmp"
    mv -f "$tmp" "$list"
    tmp=
fi

initctl restart rrwatchdoge
pgrep -x WatchDoge >/dev/null || { echo 'robot: watchdog failed to start' >&2; exit 1; }
if pgrep -x RoboController >/dev/null; then
    pkill -TERM -x RoboController
    for i in 1 2 3 4 5; do
        if ! pgrep -x RoboController >/dev/null; then break; fi
        sleep 1
    done
fi
! pgrep -x RoboController >/dev/null || { echo 'robot: controller remained running' >&2; exit 1; }
echo 'controller disabled; watchdog and Player remain running'
REMOTE
}

controller_enable() {
    "$ssh_cmd" robot bash -s <<'REMOTE'
set -euo pipefail
# ROBOT_ENABLE_CONTROLLER
list=${ROBOT_PROCESS_LIST:-/opt/rockrobo/watchdog/ProcessList.conf}
backup=${ROBOT_BACKUP:-/mnt/data/rockrobo/ProcessList.conf.robot-backup}
entry='RoboController,setsid RoboController&,1,3,0'
marker="# ROBOT_DISABLED: $entry"
tmp=
disabled_copy=
changed=0
cleanup() {
    local status=$?
    [[ -z $tmp ]] || rm -f "$tmp"
    if (( status && changed )) && [[ -n $disabled_copy && -f $disabled_copy ]]; then
        cp -p "$disabled_copy" "$list"
        initctl restart rrwatchdoge >&2 || true
    fi
    [[ -z $disabled_copy ]] || rm -f "$disabled_copy"
}
trap cleanup EXIT

if grep -Fqx "$entry" "$list"; then
    if [[ -e $backup ]]; then
        cmp -s "$list" "$backup" || { echo 'robot: recovery copy differs from enabled config' >&2; exit 1; }
        initctl restart rrwatchdoge
        for i in 1 2 3 4 5; do
            if pgrep -x RoboController >/dev/null; then break; fi
            sleep 1
        done
    fi
    pgrep -x RoboController >/dev/null && pgrep -x WatchDoge >/dev/null || {
        echo 'robot: entry enabled but controller/watchdog is not running' >&2; exit 1;
    }
    rm -f "$backup"
    echo 'controller enabled'
    exit 0
fi
[[ -f $backup && $(grep -Fxc "$entry" "$backup") == 1 && $(grep -Fxc "$marker" "$list") == 1 ]] || {
    echo 'robot: no valid recovery copy and disabled entry; refusing to guess' >&2; exit 1;
}
disabled_copy=$(mktemp "${list}.disabled.XXXXXX")
cp -p "$list" "$disabled_copy"
tmp=$(mktemp "${list}.robot.XXXXXX")
cp -p "$list" "$tmp"
awk -v entry="$entry" -v marker="$marker" '{ if ($0 == marker) print entry; else print }' "$list" > "$tmp"
changed=1
mv -f "$tmp" "$list"
tmp=
initctl restart rrwatchdoge
pgrep -x WatchDoge >/dev/null || { echo 'robot: watchdog failed to start' >&2; exit 1; }
for i in 1 2 3 4 5; do
    if pgrep -x RoboController >/dev/null; then break; fi
    sleep 1
done
pgrep -x RoboController >/dev/null || { echo 'robot: RoboController did not restart' >&2; exit 1; }
rm -f "$backup"
changed=0
echo 'controller enabled and watched'
REMOTE
}

# Run the Rust robotctl client (position/fan/move/stop) against the robot.
robotctl() {
    local binary=${ROBOT_ROBOTCTL_BIN:-} repo
    if [[ -z $binary ]]; then
        repo=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)
        binary=$repo/rust/target/release/robotctl
        [[ -x $binary ]] || binary=$repo/rust/target/debug/robotctl
        [[ -x $binary ]] || fail 'robotctl binary is missing; build: (cd rust && cargo build -p player-bridge --release)'
    fi
    local host
    host=$($ssh_cmd -G robot | awk '$1 == "hostname" { print $2; exit }')
    [[ -n $host ]] || fail 'cannot resolve SSH host robot'
    if [[ ${1:-} == move ]]; then
        local guard
        guard=$($ssh_cmd robot bash -s <<'REMOTE'
set -e
marker=$(mktemp /tmp/robot-drive-guard.XXXXXX)
nohup sh -c 'sleep 10; if test -f "$1"; then pkill -TERM -x player; rm -f "$1"; fi' robot-guard "$marker" </dev/null >/dev/null 2>&1 &
echo "$marker"
REMOTE
)
        [[ $guard == /tmp/robot-drive-guard.* && $guard != *[!a-zA-Z0-9_./-]* ]] || fail 'could not arm on-robot stop guard'
        if "$binary" "$host" "$@"; then
            "$ssh_cmd" robot rm -f -- "$guard"
        else
            echo 'robot: movement failed; on-robot guard will restart Player after 10 seconds' >&2
            return 1
        fi
    else
        "$binary" "$host" "$@"
    fi
}

# Deploy the ARM mask-owner binary if needed and print its remote path.
# Only the path goes to stdout: ssh replies are consumed or sent to stderr,
# so the caller's command substitution stays clean.
mask_owner_remote() {
    local binary=${ROBOT_MASK_OWNER_BIN:-} remote_dir=/tmp/mask-owner local_sha remote_sha
    if [[ -z $binary ]]; then
        local repo
        repo=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)
        binary=$repo/rust/target/armv7-unknown-linux-musleabihf/release/mask-owner
        [[ -x $binary ]] || fail 'mask-owner binary is missing; build: (cd rust && cargo build -p mask-owner --release --target armv7-unknown-linux-musleabihf)'
    fi
    "$ssh_cmd" robot mkdir -p -- "$remote_dir" >&2
    remote_sha=$("$ssh_cmd" robot "sha256sum $remote_dir/mask-owner 2>/dev/null | cut -d' ' -f1") || true
    local_sha=$(sha256sum "$binary" | cut -d' ' -f1)
    if [[ $remote_sha != "$local_sha" ]]; then
        "$ssh_cmd" robot "cat > $remote_dir/mask-owner.tmp && chmod 700 $remote_dir/mask-owner.tmp && mv $remote_dir/mask-owner.tmp $remote_dir/mask-owner" <"$binary" >&2 \
            || fail 'could not upload mask-owner'
    fi
    printf '%s/mask-owner\n' "$remote_dir"
}

cmd=${1:---help}
(( $# == 0 )) || shift
case $cmd in
    --help|-h|help) usage ;;
    enable|disable)
        (( $# == 0 )) || fail "usage: robot $cmd"
        case $cmd in
            enable) controller_enable ;;
            disable) controller_disable ;;
        esac ;;
    status)
        (( $# == 0 )) || fail 'usage: robot status'
        controller_status ;;
    position|fan)
        (( $# == 0 )) || fail "$cmd takes no arguments"
        robotctl "$cmd" ;;
    snapshot)
        exec "${ROBOT_CAMERA_BIN:-$(dirname "$(realpath "$0")")/camera/snapshot}" "$@" ;;
    bug)
        exec "${ROBOT_BUG_BIN:-$(dirname "$(realpath "$0")")/bug}" "$@" ;;
    move)
        with_controller=0
        if [[ ${1:-} == --with-controller ]]; then with_controller=1; shift; fi
        (( $# == 2 )) || fail 'usage: robot move [--with-controller] forward|backward|left|right <seconds>'
        case $1 in forward|backward|left|right) ;; *) fail 'unknown direction' ;; esac
        [[ $2 =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]] || fail 'duration must be a finite positive number'
        awk -v n="$2" 'BEGIN {exit !(n > 0 && n <= 2)}' || fail 'duration must be between 0 and 2 seconds'
        state=$(controller_status)
        if (( with_controller )); then
            [[ $state == enabled ]] || fail '--with-controller requires the stock controller to be running'
        else
            [[ $state == disabled ]] || fail 'stop the stock controller first (robot disable), or use --with-controller for a supervised test'
        fi
        robotctl move "$1" "$2" ;;
    mask)
        remote='' timeout=5 mask=10f8ff
        case ${1:-} in
            hold)
                shift
                while [[ $# -gt 0 ]]; do
                    case $1 in
                        --mask)
                            [[ $2 =~ ^[0-9a-fA-F]{6}$ ]] || fail 'mask must be exactly 6 hex digits (e.g. 10f8ff)'
                            mask=${2,,}; shift 2 ;;
                        --timeout)
                            [[ $2 =~ ^[1-9][0-9]*$ ]] || fail 'timeout must be positive seconds'
                            timeout=$2; shift 2 ;;
                        *) fail "unknown mask hold option: $1" ;;
                    esac
                done
                [[ $(( 0x$mask )) -ne 0 ]] || fail 'mask must not be zero'
                state=$(controller_status)
                [[ $state == disabled ]] || fail 'stop the stock controller first: the mask owner must be the sole IPC party'
                remote=$(mask_owner_remote)
                exec "$ssh_cmd" robot "$remote" hold --mask "$mask" --timeout "$timeout" ;;
            restore)
                shift
                (( $# == 0 )) || fail 'usage: robot mask restore'
                remote=$(mask_owner_remote)
                exec "$ssh_cmd" robot "$remote" restore ;;
            *) fail 'usage: robot mask hold [--mask HEX] [--timeout SECS] | restore' ;;
        esac ;;
    stop)
        (( $# == 0 )) || fail 'stop takes no arguments'
        robotctl stop ;;
    *) fail "unknown command: $cmd" ;;
esac
